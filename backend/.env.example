# ─────────────────────────────────────────────────────────────────────────────
# Sillages backend environment.
# Placeholders only — never commit real values.
# Full per-mode reference: docs/product-modes.md
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── Product mode ─────────────────────────────────────────────────────────────
# legacy         = the current product (briefs, alerts, actions, Tower, Stripe)
# social_gallery = the new product (Shopify catalogue -> shoppable gallery)
# Unset means legacy. Anything else fails validation at boot.
PRODUCT_MODE=legacy

# ── Required in EVERY mode ───────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_APP_URL=https://your-railway-app.railway.app
# Optional: defaults to the scope list in src/config/envSchema.ts
SHOPIFY_SCOPES=read_all_orders,read_products,write_products,read_customers,write_customers,read_analytics,read_inventory,read_reports,read_pixels,write_discounts,read_checkouts,write_marketing_events

# ── Required in PRODUCT_MODE=legacy, optional in social_gallery ──────────────
OPENAI_API_KEY=sk-...
RESEND_API_KEY=re_...

# ── Optional everywhere (legacy features only) ───────────────────────────────
RESEND_FROM_EMAIL=briefs@sillages.co
RESEND_WEBHOOK_SECRET=
SUPABASE_WEBHOOK_SECRET=

# Stripe — legacy billing only. Not used by social_gallery.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_GROWTH=price_...
STRIPE_PRICE_ID_SCALE=price_...

# Shopify beta app (custom distribution)
SHOPIFY_BETA_API_KEY=
SHOPIFY_BETA_API_SECRET=

# Legacy workflow flags — only read when PRODUCT_MODE=legacy.
# Set to the literal string "true" to enable; anything else is false.
USE_DYNAMIC_BRIEF=false
USE_DYNAMIC_RECOVERY=false
USE_DYNAMIC_HEALTH=false
USE_DYNAMIC_LEADS=false
USE_DYNAMIC_OUTREACH=false
USE_DYNAMIC_NURTURE=false
USE_DYNAMIC_INBOX=false
USE_DYNAMIC_CONTENT=false
OUTREACH_DAILY_CAP=20

# Postiz (self-hosted social publishing) — see docs/postiz-deploy.md
POSTIZ_API_URL=
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_ID=

# Tavily search (legacy leads workflow)
TAVILY_API_KEY=

# Web Push (VAPID) — legacy push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:support@sillages.app
