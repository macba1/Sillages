{% comment %}
  Sillages — social gallery.

  A theme app block: the merchant adds it from the theme editor, so no theme
  code is ever edited and removing the block removes every trace of it.

  The block renders an empty container and nothing else. All content is fetched
  from the Sillages public API after the page has loaded, so this never blocks
  rendering. If nothing is published, the script removes the container.
{% endcomment %}

{{ 'social-gallery.css' | asset_url | stylesheet_tag }}

<div
  data-sillages-gallery
  data-shop="{{ shop.permanent_domain }}"
  data-api="{{ block.settings.api_base | default: 'https://sillages-production.up.railway.app' }}"
  data-currency="{{ shop.currency }}"
  data-width="{{ block.settings.layout_width | default: 'full' }}"
  {%- comment -%}
    On a collection template this is the collection the shopper is looking at,
    so the gallery shows their catalogue rather than one collection chosen once
    in Sillages. Absent everywhere else, and the gallery falls back to the
    merchant's own choice.
  {%- endcomment -%}
  {% if collection.handle != blank %}data-collection="{{ collection.handle }}"{% endif %}
  {%- comment -%}
    Present only when the merchant has explicitly unticked the setting. A
    checkbox that is simply unset is nil, and `nil | default: true` and
    `false | default: true` both come back true — so the attribute says "keep",
    never "replace", and the default survives the merchant's choice either way.
  {%- endcomment -%}
  {% if block.settings.replace_catalog == false %}data-keep-catalog="true"{% endif %}
  {% if block.settings.heading != blank %}data-heading="{{ block.settings.heading | escape }}"{% endif %}
  {{ block.shopify_attributes }}
></div>

<script src="{{ 'social-gallery.js' | asset_url }}" type="module" defer></script>

{% schema %}
{
  "name": "t:names.social_gallery",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout_width",
      "label": "t:settings.layout_width.label",
      "info": "t:settings.layout_width.info",
      "default": "full",
      "options": [
        { "value": "full", "label": "t:settings.layout_width.options.full" },
        { "value": "contained", "label": "t:settings.layout_width.options.contained" }
      ]
    },
    {
      "type": "checkbox",
      "id": "replace_catalog",
      "label": "t:settings.replace_catalog.label",
      "info": "t:settings.replace_catalog.info",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading.label",
      "info": "t:settings.heading.info"
    },
    {
      "type": "text",
      "id": "api_base",
      "label": "t:settings.api_base.label",
      "info": "t:settings.api_base.info",
      "default": "https://sillages-production.up.railway.app"
    }
  ]
}
{% endschema %}
